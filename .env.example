# =============================================================================
# AI Study Podcast Gen — Environment Variables
#
# Copy this file to `.env` and fill in the values.
# Full reference: docs/environment.md
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

PORT=3000
STUDY_PLAN_CREATE_TOKEN=change-me
DASHBOARD_PUBLIC_BASE_URL=http://localhost:3000

# SQLite + Redis (local persistence and job queues)
DATABASE_URL=file:../data/app.db
REDIS_URL=redis://127.0.0.1:6379

# Local progress check (SQLite only, no Notion sync)
LOCAL_PROGRESS_ENABLED=true
LOCAL_PROGRESS_CRON=0 */12 * * *


# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------

OPENAI_API_KEY=

# LLM models — content pipeline
OPENAI_CONTENT_MODEL=gpt-5.5
OPENAI_PLANNING_MODEL=gpt-5.5
OPENAI_VALIDATION_MODEL=gpt-5.5
OPENAI_CONVERSATION_PLAN_MODEL=gpt-5.5
OPENAI_SCRIPT_MODEL=gpt-5.5
OPENAI_POLISH_MODEL=gpt-5.5

# Text-to-speech
OPENAI_TTS_MODEL=gpt-4o-mini-tts


# -----------------------------------------------------------------------------
# Notion
# -----------------------------------------------------------------------------

NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=


# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------

DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ERRORS_URL=
DISCORD_MAX_ATTACHMENT_BYTES=26214400


# -----------------------------------------------------------------------------
# Podcast — scheduling
# -----------------------------------------------------------------------------

PODCAST_CRON=0 12 * * 2,5
PODCAST_TIMEZONE=America/Sao_Paulo


# -----------------------------------------------------------------------------
# Podcast — generation
# -----------------------------------------------------------------------------

PODCAST_TARGET_MINUTES=30
DEFAULT_PODCAST_MODE=DISCUSSION
PODCAST_MAX_TURN_CHARACTERS=1200
PODCAST_MIN_TURNS=35
PODCAST_MAX_TURNS=120


# -----------------------------------------------------------------------------
# Podcast — voices
# -----------------------------------------------------------------------------

# Interview mode (DEFAULT_PODCAST_MODE=INTERVIEW)
PODCAST_INTERVIEWER_VOICE=alloy
PODCAST_CANDIDATE_VOICE=coral

# Discussion mode (DEFAULT_PODCAST_MODE=DISCUSSION)
PODCAST_HOST_VOICE=alloy
PODCAST_ENGINEER_A_VOICE=alloy
PODCAST_ENGINEER_B_VOICE=coral


# -----------------------------------------------------------------------------
# Audio — processing & storage
# -----------------------------------------------------------------------------

FFMPEG_PATH=ffmpeg
AUDIO_STORAGE_BACKEND=local

# Local storage (when AUDIO_STORAGE_BACKEND=local)
AUDIO_STORAGE_PATH=./storage/podcasts
AUDIO_PUBLIC_BASE_URL=http://localhost:3000/audio


# -----------------------------------------------------------------------------
# Audio — Google Drive (required when AUDIO_STORAGE_BACKEND=google_drive)
# -----------------------------------------------------------------------------

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER=AI Study Podcasts
GOOGLE_DRIVE_PUBLIC_SHARING=true
