{
  "name": "ai-study-podcast-gen",
  "version": "0.1.0",
  "private": true,
  "description": "Automated backend study plans and interview podcast generation",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "eval:baseline": "ts-node scripts/run-baseline.ts",
    "eval:final": "ts-node scripts/run-evaluation.ts",
    "eval:score": "ts-node scripts/score-rubric.ts",
    "eval:report": "ts-node scripts/generate-eval-report.ts",
    "eval:export-trajectories": "ts-node scripts/export-trajectories.ts",
    "eval:experiment": "ts-node scripts/run-experiment.ts",
    "eval:all": "npm run eval:baseline -- --pilot && npm run eval:final -- --pilot && npm run eval:score && npm run eval:report && npm run eval:export-trajectories",
    "eval:demo": "ts-node scripts/seed-demo-runs.ts && npm run eval:report && npm run eval:export-trajectories"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@notionhq/client": "^2.2.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "openai": "^5.12.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.33.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "dotenv": "^16.6.1"
  }
}
