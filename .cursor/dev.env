# Development placeholder environment for Cloud Agents.
# Copied to .env by .cursor/install.sh only when no .env exists.
# Contains NO real secrets. Real values injected as Cloud Agent secrets
# (process.env) take precedence over this file, so add OPENAI_API_KEY,
# NOTION_API_KEY, etc. as secrets to enable live generation.
PORT=3000
STUDY_PLAN_CREATE_TOKEN=dev-local-token
DASHBOARD_PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=file:../data/app.db
REDIS_URL=redis://127.0.0.1:6379

# Disable the periodic progress cron for a quiet local/dev environment.
LOCAL_PROGRESS_ENABLED=false

# Placeholder — replace with a real key (Cloud secret) for live generation.
OPENAI_API_KEY=sk-placeholder-local-dev

TTS_PROVIDER=kokoro
KOKORO_BASE_URL=http://127.0.0.1:8880/v1

# Placeholders so startup validation passes; these integrations are
# best-effort/dual-write and no-op with placeholder credentials.
NOTION_API_KEY=secret_placeholder_local_dev
NOTION_PARENT_PAGE_ID=00000000000000000000000000000000
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/placeholder
DISCORD_WEBHOOK_ERRORS_URL=https://discord.com/api/webhooks/000000000000000000/placeholder

FFMPEG_PATH=ffmpeg
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_PATH=./storage/podcasts
AUDIO_PUBLIC_BASE_URL=http://localhost:3000/audio
